{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=slate;Username=postgres;Password=1234",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Key": "super-secret-jwt-key-that-is-very-long",
    "Issuer": "slate-issuer",
    "Audience": "slate-audience",
    "ExpiryMinutes": 60
  },
  "AuthCookie": {
    "Name": "token",
    "HttpOnly": true,
    "Secure": true,
    "IsEssential": true,
    "SameSite": "None",
    "MaxAgeMinutes": 60
  },
  "TornadoAi": {
    "Temperature": 0.3,
    "MaxTurns": 100
  }
}
